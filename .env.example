# ==============================================================================
# QRBireg 環境変数設定テンプレート
# このファイルをコピーして「.env.local」を作成し、実際の値を設定してください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase 接続設定 (必須)
# Supabaseダッシュボードの [Project Settings] -> [API] から取得します。
# ------------------------------------------------------------------------------

# プロジェクトURL (例: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon (Public) API Key
# ブラウザ（フロントエンド）からSupabaseへのアクセスに使用される公開キー
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role (Secret) API Key (必須)
# 発表者ダッシュボード専用トークン検証など、RLSをバイパスするサーバーAPIで使用
# ※ 絶対に公開・フロントエンド側に露出させないでください。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. 管理者認証設定 (必須)
# 管理画面（/admin）へのアクセス認証に使用するパスキー
# ------------------------------------------------------------------------------

# サーバー側API認証パスキー
ADMIN_API_PASSKEY=change_this_to_a_secure_admin_passkey

# フロントエンド認証用パスキー（ADMIN_API_PASSKEYと同じ値を設定してください）
NEXT_PUBLIC_ADMIN_PASSKEY=change_this_to_a_secure_admin_passkey

